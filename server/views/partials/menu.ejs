<!-- Custom Hover Cursor -->
<div id="customCursor" class="fixed top-0 left-0 z-[999] pointer-events-none flex items-center justify-center rounded-full bg-black text-white text-[12px] font-normal uppercase tracking-wide opacity-0" style="width: 110px; height: 110px; transform: translate(-50%, -50%) scale(0);">
  <span id="customCursorText">View</span>
</div>

<!-- Full Screen Mobile/Overlay Menu -->
<div id="sideMenu" class="fixed top-0 left-0 h-[100svh] w-full sm:w-[420px] z-[100] backdrop-blur-[10px] bg-[rgba(16,16,20,0.6)] flex flex-col justify-between p-6 sm:p-10 -translate-x-full transition-transform duration-500 ease-in-out">
  <div class="menu-top flex justify-between items-center">
    <span class="font-secondary text-[18px] leading-[24px] font-medium tracking-wide text-white"><%= settings.businessName %></span>
    <button id="closeMenuBtn" class="text-white p-2.5 border border-white/25 rounded-full shrink-0">
      <i class="ri-close-line text-[18px] leading-none block"></i>
    </button>
  </div>

  <ul class="menu-middle space-y-4 sm:space-y-6 text-white text-[20px] leading-[20px]">
    <li><a href="/portfolio" class="menu-link cursor-pointer hover:opacity-50 transition-opacity block">Portfolio</a></li>
    <li><a href="/gallery" class="menu-link cursor-pointer hover:opacity-50 transition-opacity block">Gallery</a></li>
    <li><a href="/services" class="menu-link cursor-pointer hover:opacity-50 transition-opacity block">Services</a></li>
    <li><a href="/about" class="menu-link cursor-pointer hover:opacity-50 transition-opacity block">About Us</a></li>
    <li><a href="/cost-calculator" class="menu-link cursor-pointer hover:opacity-50 transition-opacity block">Cost Calculator</a></li>
    <li><a href="/virtual-projects" class="menu-link cursor-pointer hover:opacity-50 transition-opacity block">Virtual Projects</a></li>
    <li><a href="/contact" class="menu-link cursor-pointer hover:opacity-50 transition-opacity block">Enquiries</a></li>
  </ul>

  <div class="pt-6 space-y-3 border-t border-t-white/15">
    <ul class="text-[13px] sm:text-[14px] flex gap-4 font-medium tracking-[0.5px] uppercase text-white/70">
      <li><a href="<%= settings.social.instagram %>" target="_blank" rel="noopener" class="hover:text-white transition-colors">Instagram</a></li>
      <li><a href="<%= settings.social.linkedin %>" target="_blank" rel="noopener" class="hover:text-white transition-colors">Linkedin</a></li>
      <li><a href="<%= settings.social.facebook %>" target="_blank" rel="noopener" class="hover:text-white transition-colors">Facebook</a></li>
    </ul>
    <p class="text-[14px] sm:text-[15px] font-normal leading-[20px] text-white/80"><%= settings.email %></p>
  </div>
</div>

<div id="menuOverlay" class="fixed inset-0 bg-black/40 z-[90] hidden"></div>
