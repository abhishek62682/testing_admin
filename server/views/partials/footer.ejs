<!-- ============================= -->
<!-- Footer Section -->
<!-- ============================= -->
<footer class="w-full bg-[#5d5346] text-white">
  <div class="w-full px-4 sm:px-6 lg:px-10 pt-16 sm:pt-20 lg:pt-24 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr_1fr] gap-10 lg:gap-8 pb-12 sm:pb-14">

      <!-- Brand + subscribe -->
      <div class="max-w-[380px]">
        <a href="/#home" class="font-secondary text-[20px] leading-[26px] font-medium tracking-wide"><%= settings.businessName %></a>
        <p class="font-secondary text-[14px] leading-[1.9] text-white/70 mt-6 max-w-[340px]"><%= settings.footerAbout %></p>
      </div>

      <!-- INDEX -->
      <div>
        <p class="text-[12px] tracking-[1.5px] uppercase text-white/45">Index</p>
        <ul class="mt-5 space-y-3.5 text-[15px] text-white/80">
          <li><a href="/#home" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/portfolio" class="hover:text-white transition-colors">Portfolio</a></li>
          <li><a href="/gallery" class="hover:text-white transition-colors">Gallery</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
        </ul>
      </div>

      <!-- DISCIPLINES -->
      <div>
        <p class="text-[12px] tracking-[1.5px] uppercase text-white/45">Disciplines</p>
        <ul class="mt-5 space-y-3.5 text-[15px] text-white/80">
          <% (footerServices || []).forEach(function(s) { %>
            <li><a href="/services/<%= s.slug %>" class="hover:text-white transition-colors"><%= s.title %></a></li>
          <% }) %>
          <% if (!footerServices || !footerServices.length) { %>
            <li><a href="/services" class="hover:text-white transition-colors">Our Services</a></li>
          <% } %>
        </ul>
      </div>

      <!-- NETWORK -->
      <div>
        <p class="text-[12px] tracking-[1.5px] uppercase text-white/45">Network</p>
        <ul class="mt-5 space-y-3.5 text-[15px] text-white/80">
          <li><a href="<%= settings.social.instagram %>" target="_blank" rel="noopener" class="hover:text-white transition-colors">Instagram</a></li>
          <li><a href="https://wa.me/<%= settings.whatsapp %>" target="_blank" rel="noopener" class="hover:text-white transition-colors">WhatsApp</a></li>
          <li><a href="<%= settings.social.linkedin %>" target="_blank" rel="noopener" class="hover:text-white transition-colors">LinkedIn</a></li>
          <li><a href="<%= settings.social.facebook %>" target="_blank" rel="noopener" class="hover:text-white transition-colors">Facebook</a></li>
        </ul>
      </div>

      <!-- CONNECT -->
      <div>
        <p class="text-[12px] tracking-[1.5px] uppercase text-white/45">Connect</p>
        <ul class="mt-5 space-y-3.5 text-[15px] text-white/80">
          <li><a href="/contact" class="hover:text-white transition-colors">Enquiries</a></li>
          <li><a href="mailto:<%= settings.email %>" class="hover:text-white transition-colors break-words"><%= settings.email %></a></li>
          <li><a href="tel:<%= settings.phone.replace(/\s+/g,'') %>" class="hover:text-white transition-colors"><%= settings.phone %></a></li>
          <li class="text-white/70 leading-snug"><%= settings.address %></li>
        </ul>
      </div>

    </div>

  </div>

  <!-- Sub footer -->
  <div class="w-full bg-[#4a4238]">
    <div class="w-full px-4 sm:px-6 lg:px-10 py-5 flex flex-col sm:flex-row justify-between items-center gap-3 sm:gap-0 text-[13px] text-white/60">
      <p><%= settings.footerCopyright %></p>
      <div class="flex gap-6">
        <a href="#!" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#!" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
