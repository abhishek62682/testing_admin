<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login · <%= settings.businessName %></title>
  <style>
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #2b2724; color: #2b2724; height: 100vh; display: flex; align-items: center; justify-content: center; }
    .card { background: #fff; border-radius: 12px; padding: 40px; width: 100%; max-width: 380px; }
    h1 { font-size: 20px; margin: 0 0 4px; }
    p.sub { font-size: 13px; color: #857b70; margin: 0 0 24px; }
    .field-group { margin-bottom: 16px; }
    label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
    input { width: 100%; padding: 10px 12px; border: 1px solid #ddd4c4; border-radius: 6px; font-size: 14px; box-sizing: border-box; }
    button { width: 100%; padding: 12px; border: none; border-radius: 6px; background: #5d5346; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; margin-top: 8px; }
    .flash-error { background: #fbe7e5; color: #c0392b; padding: 10px 14px; border-radius: 6px; font-size: 13px; margin-bottom: 16px; }
  </style>
</head>
<body>
  <div class="card">
    <h1><%= settings.businessName %></h1>
    <p class="sub">Admin Panel Login</p>
    <% if (errorMsg && errorMsg.length) { %><div class="flash-error"><%= errorMsg[0] %></div><% } %>
    <form method="POST" action="/admin/login">
      <div class="field-group">
        <label>Username or Email</label>
        <input type="text" name="username" required autofocus>
      </div>
      <div class="field-group">
        <label>Password</label>
        <input type="password" name="password" required>
      </div>
      <button type="submit">Log In</button>
    </form>
  </div>
</body>
</html>
