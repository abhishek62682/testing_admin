<%- include('../partials/_head') %>

<div class="top-bar">
  <h1 style="margin:0;">Enquiries</h1>
  <a class="btn btn-primary" href="/admin/enquiries/export.xlsx">&#8681; Download Excel</a>
</div>

<div class="card" style="padding: 12px 16px; display:flex; gap:8px; align-items:center;">
  <span class="hint" style="margin:0;">Filter:</span>
  <a class="btn btn-sm <%= activeSource === '' ? 'btn-primary' : 'btn-secondary' %>" href="/admin/enquiries">All</a>
  <a class="btn btn-sm <%= activeSource === 'contact' ? 'btn-primary' : 'btn-secondary' %>" href="/admin/enquiries?source=contact">Contact Form</a>
  <a class="btn btn-sm <%= activeSource === 'cost-calculator' ? 'btn-primary' : 'btn-secondary' %>" href="/admin/enquiries?source=cost-calculator">Cost Calculator</a>
</div>

<div class="card">
  <table>
    <thead>
      <tr>
        <th>Date</th><th>Source</th><th>Name</th><th>Phone</th><th>Email</th><th>Details</th><th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% enquiries.forEach(function(e) { %>
        <tr style="<%= e.read ? '' : 'background:#fbf6ee;' %>">
          <td><%= e.createdAt.toLocaleString('en-IN') %></td>
          <td><span class="badge <%= e.source === 'contact' ? 'on' : '' %>"><%= e.source === 'contact' ? 'Contact' : 'Calculator' %></span></td>
          <td><%= e.name %><% if (!e.read) { %> <span class="nav-badge" style="margin-left:6px;">new</span><% } %></td>
          <td><a href="tel:<%= e.phone %>"><%= e.phone %></a></td>
          <td><% if (e.email) { %><a href="mailto:<%= e.email %>"><%= e.email %></a><% } else { %>—<% } %></td>
          <td style="max-width:260px; font-size:13px; color:#4a453f;">
            <% if (e.source === 'contact') { %>
              <%= e.message || '—' %>
            <% } else { %>
              <%= e.city %><% if (e.pincode) { %> - <%= e.pincode %><% } %><br>
              <%= e.area %> · <%= e.bhk %> · <%= e.package %><br>
              <strong><%= e.estimatedTotal %></strong>
            <% } %>
          </td>
          <td class="actions">
            <% if (!e.read) { %>
              <form class="inline" method="POST" action="/admin/enquiries/<%= e._id %>/read">
                <button class="btn btn-secondary btn-sm" type="submit">Mark read</button>
              </form>
            <% } %>
            <form class="inline" method="POST" action="/admin/enquiries/<%= e._id %>/delete" onsubmit="return confirm('Delete this enquiry?');">
              <button class="btn btn-danger btn-sm" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (!enquiries.length) { %><tr><td colspan="7">No enquiries yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/_foot') %>
