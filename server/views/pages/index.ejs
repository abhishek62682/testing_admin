<!doctype html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>

  <body>
    <div class="root relative">

      <%- include('../partials/menu') %>

      <header class="relative h-[100svh] min-h-[640px] overflow-hidden" id="home">
        <img class="absolute inset-0 w-full h-full object-cover bg-black" src="<%= settings.heroImage %>" alt="<%= settings.businessName %> interior">
        <div class="absolute inset-0 z-[1]" style="background-color: #191919; opacity: .6; overflow: clip; flex: none; -webkit-mask: linear-gradient(#000 0%, #000000b3 48.6884%, #000 100%); mask: linear-gradient(#000 0%, #000000b3 48.6884%, #000 100%);"></div>

        <div class="relative z-[20] h-full flex flex-col text-white">

          <%- include('../partials/nav', { navTheme: 'white' }) %>

          <div class="flex-1 px-4 sm:px-6 lg:px-10 pt-[150px] sm:pt-56 lg:pt-[150px]">
            <div class="relative h-full">

              <h1 class="font-secondary font-light max-w-[400px] sm:max-w-[760px] text-[30px] leading-[34px] text-white sm:text-[40px] sm:leading-[44px] lg:text-[60px] lg:leading-[66px]">
                <%= settings.heroTitle %>
              </h1>

              <div class="mt-8 max-w-[420px] space-y-5 md:mt-0 md:absolute md:right-0 md:top-1/2 md:-translate-y-1/2 md:max-w-[380px]">
                <p class="font-secondary text-[14px] leading-[18px] font-medium text-white/90">
                  <%= settings.heroDescription %>
                </p>
                <a href="#our-projects" class="menu-link inline-block font-secondary text-[16px] leading-[21px] font-medium border-b border-white/60 pb-1 hover:opacity-70 transition-opacity">View projects</a>
              </div>

            </div>
          </div>

          <div class="px-4 sm:px-6 lg:px-10 pb-[60px] sm:pb-10">
            <div class="grid grid-cols-2 gap-x-6 gap-y-5 sm:flex sm:justify-between font-secondary text-[14px] leading-[16px] sm:text-[16px] sm:leading-[21px] font-medium">
              <div class="min-w-0 sm:w-50 sm:shrink-0">
                <p class="text-white/60 whitespace-nowrap">Studio</p>
                <p class="mt-1"><%= settings.heroStudioLocation %></p>
              </div>
              <div class="sm:w-50 sm:shrink-0">
                <p class="text-white/60 whitespace-nowrap">Est. since</p>
                <p class="mt-1"><%= settings.heroEstSince %></p>
              </div>
              <div class="order-2 sm:order-none sm:w-50 sm:shrink-0">
                <p class="text-white/60">Speciality</p>
                <p class="mt-1"><%= settings.heroSpeciality %></p>
              </div>
              <div class="order-1 sm:order-none sm:w-50">
                <p class="text-white/60">Rating</p>
                <p class="mt-1"><%= settings.heroRating %></p>
              </div>
            </div>
          </div>

        </div>
      </header>

      <div class="main-content relative">
        <div class="page-wrapper relative z-[10]">

          <!-- Statement Section -->
          <section class="relative w-full bg-white min-h-[100svh] overflow-hidden px-4 sm:px-6 lg:px-10 py-25 sm:py-16 lg:py-20 flex items-center justify-center">
            <div class="max-w-7xl mx-auto w-full relative h-[420px] sm:h-[550px] md:h-[650px] lg:h-[750px]">

              <div class="reveal-up absolute top-4 left-2 sm:top-10 sm:left-10 md:top-16 md:left-16 w-[90px] sm:w-[140px] md:w-[170px] lg:w-[200px] overflow-hidden">
                <img class="w-full h-full object-cover" src="https://framerusercontent.com/images/O64BvWg7qKxhwTsoaMwOogOpIws.png?scale-down-to=512&width=1200&height=1200" alt="Interior hallway">
              </div>

              <div class="reveal-up absolute top-4 right-2 sm:top-10 sm:right-10 md:top-16 md:right-16 w-[80px] sm:w-[140px] md:w-[170px] lg:w-[200px] overflow-hidden">
                <img class="w-full h-full object-cover" src="https://framerusercontent.com/images/2fWepbEq4iRUJ6C2yZ31VIckXc4.png?scale-down-to=1024&width=800&height=1200" alt="Interior living room">
              </div>

              <div class="reveal-up absolute bottom-4 left-2 sm:bottom-10 sm:left-10 md:bottom-16 md:left-16 w-[75px] sm:w-[125px] md:w-[155px] lg:w-[180px] overflow-hidden">
                <img class="w-full h-full object-cover" src="https://framerusercontent.com/images/C1JRgFChrNMq7qX0hGThqIhtS4.png?scale-down-to=1024&width=904&height=1200" alt="Interior wall art">
              </div>

              <div class="reveal-up absolute bottom-4 right-2 sm:bottom-10 sm:right-10 md:bottom-16 md:right-16 w-[90px] sm:w-[140px] md:w-[170px] lg:w-[200px] overflow-hidden">
                <img class="w-full h-full object-cover" src="https://framerusercontent.com/images/92QXDUHTXvpknuenDhJMWw8R40.png?scale-down-to=1024&width=1200&height=673" alt="Interior sitting area">
              </div>

              <div class="absolute inset-0 z-10 flex items-center justify-center px-2">
                <h2 class="split max-w-[880px] font-normal leading-[30px] sm:leading-[44px] md:leading-[52px] lg:leading-[58px] text-[22px] text-center sm:text-[34px] md:text-[42px] lg:text-[48px] text-black tracking-tight font-primary">
                  From concept to completion, we craft interiors that reflect who you are and how you live.
                </h2>
              </div>

            </div>
          </section>

          <!-- Our Projects Section -->
          <section id="our-projects">
            <div class="bg-[#5d5346] py-25 sm:py-24 md:py-[100px] lg:py-[125px]">
              <div class="container-x space-y-[50px] md:space-y-10 lg:space-y-12.5">

                <div class="section-header text-center md:text-left text-white space-y-2.5">
                  <h2 class="split font-primary font-normal text-[28px] sm:text-[36px] md:text-[42px] lg:text-[48px] leading-[34px] sm:leading-[44px] md:leading-[50px] lg:leading-[58px]">Our Projects</h2>
                  <p class="max-w-[320px] mx-auto md:mx-0 text-center md:text-left sm:max-w-[420px] text-[16px] sm:text-[17px] font-normal leading-[1.75]">A curated showcase of our finest interior spaces, crafted with bespoke design and flawless execution</p>

                  <a href="/portfolio" class="group relative inline-flex justify-center text-[13px] sm:text-[14px] font-normal leading-[20px]">
                    <span class="after:absolute after:bottom-0 after:left-1/2 after:h-px after:w-full after:-translate-x-1/2 after:bg-white after:transition-all after:duration-500 after:ease-in-out group-hover:after:w-[20%]">
                      VIEW ALL PROJECTS
                    </span>
                  </a>
                </div>

                <div class="section-content">
                  <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6.25 lg:gap-5">
                    <% projects.forEach(function(p) { %>
                      <div class="project group space-y-3 sm:space-y-3.75">
                        <div class="project-image w-full h-[520px] sm:h-[380px] md:h-[450px] lg:h-[520px]">
                          <img class="w-full h-full object-cover" src="<%= p.image %>" alt="<%= p.title %>">
                        </div>
                        <h4 class="split text-[18px] sm:text-[20px] lg:text-[22px] font-normal font-primary text-white leading-[22px] sm:leading-[24px] lg:leading-[26px]"><%= p.title %></h4>
                      </div>
                    <% }) %>
                  </div>
                </div>

              </div>
            </div>
          </section>

          <!-- What We Do Section -->
          <div id="services" class="py-25 bg-white sm:py-24 md:py-[100px] lg:py-[125px]">
            <div class="container-x space-y-8 sm:space-y-10 lg:space-y-12.5">

              <div class="section-header text-black space-y-2.5">
                <h2 class="split font-primary font-normal text-[28px] sm:text-[36px] md:text-[42px] lg:text-[48px] leading-[34px] sm:leading-[44px] md:leading-[50px] lg:leading-[58px]">What We Do</h2>
                <p class="max-w-[300px] sm:max-w-[380px] text-[16px] sm:text-[17px] font-normal leading-[1.75]">Full-service interior design, from concept to styling and everything in between.</p>
              </div>

              <div class="section-content">
                <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6.25 lg:gap-5">

                  <div class="project space-y-3 sm:space-y-3.75">
                    <div class="project-image hidden md:block w-full h-[280px] sm:h-[380px] md:h-[450px] lg:h-[520px]"></div>
                  </div>

                  <% homeServices.forEach(function(s, i) { %>
                    <div class="project group space-y-3 sm:space-y-3.75">
                      <div class="project-image w-full h-[280px] sm:h-[380px] md:h-[450px] <%= i % 2 === 0 ? 'lg:h-[270px]' : 'lg:h-[472px]' %>">
                        <img class="w-full h-full object-cover" src="<%= s.image %>" alt="<%= s.title %>">
                      </div>
                      <h4 class="split text-[18px] sm:text-[20px] lg:text-[22px] font-normal font-primary leading-[22px] sm:leading-[24px] lg:leading-[26px]"><%= s.title %></h4>
                    </div>
                  <% }) %>

                </div>

                <a href="/services" class="inline-flex items-center gap-2 mt-8 sm:mt-10 border border-black/70 px-6 sm:px-7 py-3 text-[12px] sm:text-[13px] font-medium tracking-[1.5px] uppercase text-black hover:bg-black hover:text-white transition-colors duration-300">
                  View All Services <span aria-hidden="true">&rarr;</span>
                </a>
              </div>

            </div>
          </div>

          <!-- Stats / Counters Section -->
          <section id="stats">
            <div class="bg-[#5d5346] py-16 sm:py-20 lg:py-24">
              <div class="container-x">
                <div class="grid grid-cols-3 gap-4 sm:gap-8 text-center text-white divide-x divide-white/15">
                  <div class="counter-item px-2">
                    <p class="counter split font-primary text-[32px] sm:text-[48px] md:text-[56px] leading-none" data-count="50" data-suffix="+">0+</p>
                    <p class="mt-2 sm:mt-3 text-[12px] sm:text-[14px] tracking-[1.5px] uppercase text-white/70">Projects</p>
                  </div>
                  <div class="counter-item px-2">
                    <p class="counter split font-primary text-[32px] sm:text-[48px] md:text-[56px] leading-none" data-count="8" data-suffix="">0</p>
                    <p class="mt-2 sm:mt-3 text-[12px] sm:text-[14px] tracking-[1.5px] uppercase text-white/70">Years Experience</p>
                  </div>
                  <div class="counter-item px-2">
                    <p class="counter split font-primary text-[32px] sm:text-[48px] md:text-[56px] leading-none" data-count="100" data-suffix="+">0+</p>
                    <p class="mt-2 sm:mt-3 text-[12px] sm:text-[14px] tracking-[1.5px] uppercase text-white/70">Happy Clients</p>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Testimonials Section -->
          <section id="testimonials">
            <div class="py-16 sm:py-24 bg-[#ece7de] md:py-[100px] lg:py-[125px] relative">
              <div class="container-x space-y-8 sm:space-y-10 lg:space-y-12.5">

                <div class="section-header text-black space-y-2.5">
                  <h2 class=" font-primary font-normal text-[28px] sm:text-[36px] md:text-[42px] lg:text-[48px] leading-[34px] text-center sm:leading-[44px] md:leading-[50px] lg:leading-[58px]">Testimonials</h2>
                </div>

                <div class="section-content">
                  <div class="max-w-[900px] mx-auto">
                    <div id="testimonialArea" class="swiper testimonialSwiper" style="cursor: none;">
                      <div class="swiper-wrapper">
                        <% testimonials.forEach(function(t) { %>
                          <div class="swiper-slide">
                            <figure class="flex flex-col items-center text-center px-2">
                              <div class="relative w-[112px] h-[112px]">
                                <img class="w-full h-full rounded-full object-cover" src="<%= t.image %>" alt="<%= t.name %>">
                                <span class="absolute bottom-0 right-0 w-9 h-9 rounded-full bg-black text-white flex items-center justify-center text-[16px]"><i class="ri-double-quotes-r"></i></span>
                              </div>
                              <figcaption class="mt-6">
                                <p class="text-[16px] font-semibold text-black"><%= t.name %></p>
                                <p class="text-[13px] text-black/45 mt-1"><%= t.role %></p>
                              </figcaption>
                              <blockquote class="mt-8 font-primary font-normal text-black/85 text-[16px] sm:text-[19px] lg:text-[22px] leading-[1.6] max-w-[720px]"><%= t.quote %></blockquote>
                            </figure>
                          </div>
                        <% }) %>
                      </div>
                    </div>

                    <div class="testimonial-frac mt-12 text-center font-secondary text-[14px] tracking-wide text-black/60"></div>
                  </div>
                </div>

              </div>
            </div>

            <div id="dragCursor" class="fixed top-0 left-0 z-[999] pointer-events-none flex items-center justify-center rounded-full bg-black text-white text-[12px] font-normal uppercase tracking-wide" style="width: 90px; height: 90px; opacity: 0; transform: translate(-50%, -50%) scale(0);">
              Drag
            </div>
          </section>

          <!-- Clients / Collaborations -->
          <section id="clients" class="bg-white py-16 sm:py-20 md:py-24 lg:py-28">
            <div class="container-x">

              <div class="section-header text-center max-w-[820px] mx-auto space-y-2.5">
                <h2 class="split font-primary font-normal text-[28px] sm:text-[36px] md:text-[42px] lg:text-[48px] leading-[34px] sm:leading-[44px] md:leading-[50px] lg:leading-[58px] text-black">Our Valued Clients</h2>
                <p class="text-[16px] sm:text-[17px] font-normal leading-[1.75] max-w-[720px] mx-auto">Trusted by homeowners, developers and leading brands across the region, <br class="hidden sm:block"> we take pride in building lasting relationships through thoughtful design and reliable execution.</p>
              </div>

              <div class="mt-12 sm:mt-16 flex flex-wrap items-center justify-center gap-x-10 sm:gap-x-16 gap-y-10 sm:gap-y-14">
                <div class="flex items-center justify-center h-14 sm:h-16"><img class="max-h-full w-auto object-contain" src="/assets/img/clients/client-01.png" alt="Client logo"></div>
                <div class="flex items-center justify-center h-14 sm:h-16"><img class="max-h-full w-auto object-contain" src="/assets/img/clients/client-02.png" alt="Client logo"></div>
                <div class="flex items-center justify-center h-14 sm:h-16"><img class="max-h-full w-auto object-contain" src="/assets/img/clients/client-03.png" alt="Client logo"></div>
                <div class="flex items-center justify-center h-14 sm:h-16"><img class="max-h-full w-auto object-contain" src="/assets/img/clients/client-04.png" alt="Client logo"></div>
                <div class="flex items-center justify-center h-14 sm:h-16"><img class="max-h-full w-auto object-contain" src="/assets/img/clients/client-05.png" alt="Client logo"></div>
                <div class="flex items-center justify-center h-14 sm:h-16"><img class="max-h-full w-auto object-contain" src="/assets/img/clients/client-06.png" alt="Client logo"></div>
                <div class="flex items-center justify-center h-14 sm:h-16"><img class="max-h-full w-auto object-contain" src="/assets/img/clients/client-07.png" alt="Client logo"></div>
                <div class="flex items-center justify-center h-14 sm:h-16"><img class="max-h-full w-auto object-contain" src="/assets/img/clients/client-08.png" alt="Client logo"></div>
                <div class="flex items-center justify-center h-14 sm:h-16"><img class="max-h-full w-auto object-contain" src="/assets/img/clients/client-09.png" alt="Client logo"></div>
              </div>

            </div>
          </section>

          <!-- Contact Section -->
          <%- include('../partials/cta') %>

        </div>
      </div>

      <%- include('../partials/footer') %>

    </div>

    <!-- Third-party scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/SplitText.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>

    <!-- Testimonials swiper + drag cursor -->
    <script>
      const testimonialSwiper = new Swiper(".testimonialSwiper", {
        speed: 700,
        grabCursor: false,
        loop: true,
        spaceBetween: 40,
        autoplay: { delay: 5000, disableOnInteraction: false },
        pagination: { el: ".testimonial-frac", type: "fraction" },
      });

      const dragCursor = document.getElementById("dragCursor");
      const swiperArea = document.getElementById("testimonialArea");

      gsap.set(dragCursor, { xPercent: -50, yPercent: -50 });

      const dragXTo = gsap.quickTo(dragCursor, "x", { duration: 0.5, ease: "power3" });
      const dragYTo = gsap.quickTo(dragCursor, "y", { duration: 0.5, ease: "power3" });

      window.addEventListener("mousemove", (e) => { dragXTo(e.clientX); dragYTo(e.clientY); });

      swiperArea.addEventListener("mouseenter", () => { gsap.to(dragCursor, { opacity: 1, scale: 1, duration: 0.4, ease: "power3.out" }); });
      swiperArea.addEventListener("mouseleave", () => { gsap.to(dragCursor, { opacity: 0, scale: 0, duration: 0.4, ease: "power3.out" }); });
      swiperArea.addEventListener("mousedown", () => { gsap.to(dragCursor, { scale: 1.3, duration: 0.3, ease: "power2.out" }); });
      swiperArea.addEventListener("mouseup", () => { gsap.to(dragCursor, { scale: 1, duration: 0.3, ease: "power2.out" }); });
    </script>

    <!-- SplitText word-reveal animation -->
    <script>
      gsap.registerPlugin(SplitText, ScrollTrigger);
      document.fonts.ready.then(() => {
        document.querySelectorAll(".split").forEach((el) => {
          if (el.closest(".hero-content")) return;
          if (el.classList.contains("counter")) return;
          const split = SplitText.create(el, { type: "words, lines", mask: "lines", linesClass: "line++" });
          gsap.from(split.words, {
            yPercent: 200, opacity: 0, duration: 1.2, ease: "expo.out", stagger: 0.08,
            scrollTrigger: { trigger: el, start: "top 88%" },
          });
        });
      });
    </script>

    <!-- Generic scroll-reveal -->
    <script>
      gsap.utils.toArray(".reveal-up").forEach((el, i) => {
        gsap.to(el, { opacity: 1, y: 0, duration: 1, ease: "power3.out", delay: (i % 4) * 0.08, scrollTrigger: { trigger: el, start: "top 90%" } });
      });
      gsap.utils.toArray("#our-projects .project").forEach((el, i) => {
        gsap.fromTo(el, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.9, ease: "power3.out", delay: (i % 3) * 0.1, scrollTrigger: { trigger: el, start: "top 92%" } });
      });
    </script>

    <!-- Stat counters -->
    <script>
      gsap.utils.toArray(".counter").forEach((el) => {
        const target = parseInt(el.getAttribute("data-count"), 10);
        const suffix = el.getAttribute("data-suffix") || "";
        const counterObj = { val: 0 };
        gsap.to(counterObj, {
          val: target, duration: 2, ease: "power2.out",
          scrollTrigger: { trigger: el, start: "top 90%", once: true },
          onUpdate: () => { el.textContent = Math.floor(counterObj.val) + suffix; },
        });
      });
    </script>

    <%- include('../partials/scripts-common') %>

    <!-- Custom hover cursor -->
    <script>
      const customCursor = document.getElementById("customCursor");
      const cursorText = document.getElementById("customCursorText");
      gsap.set(customCursor, { xPercent: -50, yPercent: -50 });
      const cursorX = gsap.quickTo(customCursor, "x", { duration: 0.5, ease: "power3" });
      const cursorY = gsap.quickTo(customCursor, "y", { duration: 0.5, ease: "power3" });
      window.addEventListener("mousemove", (e) => { cursorX(e.clientX); cursorY(e.clientY); });
      function bindCursor(selector, text) {
        document.querySelectorAll(selector).forEach((el) => {
          el.addEventListener("mouseenter", () => { cursorText.textContent = text; gsap.to(customCursor, { opacity: 1, scale: 1, duration: 0.4, ease: "power3.out" }); });
          el.addEventListener("mouseleave", () => { gsap.to(customCursor, { opacity: 0, scale: 0, duration: 0.4, ease: "power3.out" }); });
        });
      }
      bindCursor("#our-projects .project-image", "View Project");
    </script>

  </body>
</html>
