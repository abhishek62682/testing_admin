<!doctype html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>

  <body class="bg-[#efe9df] text-[#2b2724]">
    <div class="root relative">

      <%- include('../partials/menu') %>
      <%- include('../partials/nav', { navTheme: 'white' }) %>

      <!-- HERO -->
      <section id="services-hero" class="relative h-[100svh] min-h-[600px] overflow-hidden">
        <img class="absolute inset-0 w-full h-full object-cover" src="https://framerusercontent.com/images/T6geNXuDqq1KVexrgVr7YFywx4.png?scale-down-to=1024&width=1200&height=802" alt="<%= settings.businessName %> interior">
        <div class="absolute inset-0 bg-black/55"></div>
        <div class="relative z-10 h-full flex items-center justify-center text-center text-white px-4">
          <div class="container-x">
            <div class="max-w-[900px] mx-auto space-y-5 sm:space-y-7">
              <p class="font-secondary text-[14px] leading-[20px] tracking-[2px] text-white/80">Services</p>
              <h1 class="font-primary font-normal text-[36px] leading-[42px] sm:text-[56px] sm:leading-[62px] lg:text-[72px] lg:leading-[80px]">What We Do</h1>
            </div>
          </div>
        </div>
        <div class="absolute bottom-10 sm:bottom-14 left-0 w-full z-10 px-4">
          <div class="container-x flex justify-center">
            <p class="font-secondary text-[14px] leading-[20px] text-white/90 text-center max-w-[520px]">From interiors to civil work, we offer full-service design and execution — thoughtfully crafted, precisely built, and delivered end to end.</p>
          </div>
        </div>
      </section>

      <!-- SERVICES GRID -->
      <main>
        <section class="py-16 sm:py-24 md:py-[100px] lg:py-[125px]">
          <div class="container-x max-w-[1200px]">
            <div class="max-w-[560px] space-y-2.5">
              <h2 class="font-primary font-normal text-[28px] sm:text-[36px] md:text-[42px] lg:text-[48px] leading-[1.15] text-[#2b2724]">Our Services</h2>
              <p class="font-secondary text-[14px] leading-[20px] text-[#857b70]">Everything your space needs, under one roof — design, construction, and bespoke fabrication.</p>
            </div>

            <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6.25 md:gap-6 lg:gap-5">
              <% services.forEach(function(s, i) { %>
                <a href="/services/<%= s.slug %>" class="project group space-y-3 sm:space-y-3.75 <%= [1,4].includes(i) ? 'lg:mt-16' : (i===2 ? 'lg:mt-8' : '') %> block">
                  <div class="project-image w-full h-[280px] sm:h-[380px] md:h-[450px] lg:h-[420px]">
                    <img class="w-full h-full object-cover" src="<%= s.image %>" alt="<%= s.title %>">
                  </div>
                  <h4 class="text-[18px] sm:text-[20px] lg:text-[22px] font-normal font-primary leading-[22px] sm:leading-[24px] lg:leading-[26px]"><%= s.title %></h4>
                </a>
              <% }) %>
              <% if (!services.length) { %>
                <p class="font-secondary text-[14px] text-[#857b70]">Services coming soon.</p>
              <% } %>
            </div>
          </div>
        </section>

        <%- include('../partials/cta') %>
      </main>

      <%- include('../partials/footer') %>

    </div>

    <script>
      const sideMenu = document.getElementById("sideMenu");
      const menuOverlay = document.getElementById("menuOverlay");
      document.getElementById("openMenuBtn").addEventListener("click", () => { sideMenu.classList.remove("-translate-x-full"); menuOverlay.classList.remove("hidden"); document.documentElement.style.overflow="hidden"; });
      const closeMenu = () => { sideMenu.classList.add("-translate-x-full"); menuOverlay.classList.add("hidden"); document.documentElement.style.overflow=""; };
      document.getElementById("closeMenuBtn").addEventListener("click", closeMenu);
      menuOverlay.addEventListener("click", closeMenu);
      document.querySelectorAll(".menu-link").forEach((l) => l.addEventListener("click", closeMenu));

      const mainNav = document.getElementById("mainNav");
      mainNav.style.transition = "transform 0.4s ease, background-color 0.3s ease, box-shadow 0.3s ease";
      let lastY = window.scrollY;
      function onScroll(){
        const y = window.scrollY;
        if (y>40){ mainNav.style.backgroundColor="rgba(255,255,255,0.72)"; mainNav.style.backdropFilter="blur(12px)"; mainNav.style.webkitBackdropFilter="blur(12px)"; mainNav.style.boxShadow="0 6px 20px rgba(0,0,0,0.06)"; mainNav.style.color="#141414"; }
        else { mainNav.style.backgroundColor=""; mainNav.style.backdropFilter=""; mainNav.style.webkitBackdropFilter=""; mainNav.style.boxShadow=""; mainNav.style.color=""; }
        const d=y-lastY; if (Math.abs(d)>8){ mainNav.style.transform=(d>0&&y>80)?"translateY(-100%)":"translateY(0)"; lastY=y; }
      }
      onScroll(); window.addEventListener("scroll", onScroll, { passive:true });
    </script>

  </body>
</html>
