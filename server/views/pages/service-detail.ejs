<!doctype html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>

  <body class="bg-[#efe9df] text-[#2b2724]">
    <div class="root relative">

      <%- include('../partials/menu') %>
      <%- include('../partials/nav', { navTheme: 'white' }) %>

      <!-- HERO -->
      <section class="relative h-[70svh] min-h-[440px] overflow-hidden">
        <img class="absolute inset-0 w-full h-full object-cover" src="<%= service.image %>" alt="<%= service.title %>">
        <div class="absolute inset-0 bg-black/55"></div>
        <div class="relative z-10 h-full flex items-center justify-center text-center text-white px-4">
          <div class="container-x">
            <div class="max-w-[900px] mx-auto space-y-5">
              <% if (service.category) { %><p class="font-secondary text-[14px] leading-[20px] tracking-[2px] text-white/80"><%= service.category %></p><% } %>
              <h1 class="font-primary font-normal text-[36px] leading-[42px] sm:text-[52px] sm:leading-[58px] lg:text-[64px] lg:leading-[70px]"><%= service.title %></h1>
              <% if (service.shortDescription) { %><p class="font-secondary text-[15px] leading-[22px] text-white/90 max-w-[560px] mx-auto"><%= service.shortDescription %></p><% } %>
            </div>
          </div>
        </div>
      </section>

      <main>
        <section class="py-16 sm:py-24 md:py-[100px] lg:py-[125px]">
          <div class="container-x max-w-[900px] space-y-14">

            <% if (service.content) { %>
              <div class="font-secondary text-[15px] leading-[1.9] text-[#4a453f] whitespace-pre-line"><%= service.content %></div>
            <% } %>

            <% if (service.benefits && service.benefits.length) { %>
              <div class="space-y-6">
                <h2 class="font-primary font-normal text-[26px] sm:text-[32px] leading-[1.2] text-[#2b2724]">Benefits</h2>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
                  <% service.benefits.forEach(function(b) { %>
                    <li class="flex items-start gap-3 font-secondary text-[15px] leading-[1.6] text-[#4a453f]">
                      <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#5d5346] shrink-0"></span>
                      <span><%= b %></span>
                    </li>
                  <% }) %>
                </ul>
              </div>
            <% } %>

            <% if (service.faqs && service.faqs.length) { %>
              <div class="space-y-6">
                <h2 class="font-primary font-normal text-[26px] sm:text-[32px] leading-[1.2] text-[#2b2724]">Frequently Asked Questions</h2>
                <div class="divide-y divide-black/10 border-t border-b border-black/10">
                  <% service.faqs.forEach(function(f) { %>
                    <details class="group py-5">
                      <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-secondary text-[15px] font-semibold text-[#2b2724]">
                        <span><%= f.question %></span>
                        <span class="shrink-0 text-[#857b70] group-open:rotate-45 transition-transform">+</span>
                      </summary>
                      <p class="mt-3 font-secondary text-[14px] leading-[1.7] text-[#6b6259]"><%= f.answer %></p>
                    </details>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <div>
              <a href="/services" class="inline-flex items-center gap-2 border border-black/70 px-6 sm:px-7 py-3 text-[12px] sm:text-[13px] font-medium tracking-[1.5px] uppercase text-black hover:bg-black hover:text-white transition-colors duration-300">
                &larr; All Services
              </a>
            </div>

          </div>
        </section>

        <%- include('../partials/cta') %>
      </main>

      <%- include('../partials/footer') %>

    </div>

    <script>
      const sideMenu = document.getElementById("sideMenu");
      const menuOverlay = document.getElementById("menuOverlay");
      document.getElementById("openMenuBtn").addEventListener("click", () => { sideMenu.classList.remove("-translate-x-full"); menuOverlay.classList.remove("hidden"); document.documentElement.style.overflow="hidden"; });
      const closeMenu = () => { sideMenu.classList.add("-translate-x-full"); menuOverlay.classList.add("hidden"); document.documentElement.style.overflow=""; };
      document.getElementById("closeMenuBtn").addEventListener("click", closeMenu);
      menuOverlay.addEventListener("click", closeMenu);
      document.querySelectorAll(".menu-link").forEach((l) => l.addEventListener("click", closeMenu));

      const mainNav = document.getElementById("mainNav");
      mainNav.style.transition = "transform 0.4s ease, background-color 0.3s ease, box-shadow 0.3s ease";
      let lastY = window.scrollY;
      function onScroll(){
        const y = window.scrollY;
        if (y>40){ mainNav.style.backgroundColor="rgba(255,255,255,0.72)"; mainNav.style.backdropFilter="blur(12px)"; mainNav.style.webkitBackdropFilter="blur(12px)"; mainNav.style.boxShadow="0 6px 20px rgba(0,0,0,0.06)"; mainNav.style.color="#141414"; }
        else { mainNav.style.backgroundColor=""; mainNav.style.backdropFilter=""; mainNav.style.webkitBackdropFilter=""; mainNav.style.boxShadow=""; mainNav.style.color=""; }
        const d=y-lastY; if (Math.abs(d)>8){ mainNav.style.transform=(d>0&&y>80)?"translateY(-100%)":"translateY(0)"; lastY=y; }
      }
      onScroll(); window.addEventListener("scroll", onScroll, { passive:true });
    </script>

  </body>
</html>
