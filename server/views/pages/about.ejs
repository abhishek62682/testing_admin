<!doctype html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>

  <body>
    <div class="root relative">

      <%- include('../partials/menu') %>
      <%- include('../partials/nav', { navTheme: 'white' }) %>

      <main class="main-content">

        <!-- ABOUT HERO -->
        <section id="about-hero" class="relative h-[100svh] min-h-[620px] overflow-hidden">
          <img class="absolute inset-0 w-full h-full object-cover" src="https://framerusercontent.com/images/Y2Yp18uPF5BVQ1kFtuBU46jol74.png?width=1200&height=1200" alt="<%= settings.businessName %> interior">
          <div class="absolute inset-0 bg-black/50"></div>

          <div class="relative z-10 h-full flex items-center justify-center text-center text-white px-4">
            <div class="container-x">
              <div class="max-w-[900px] mx-auto space-y-5 sm:space-y-7">
                <p class="font-secondary text-[14px] leading-[20px] tracking-[2px] text-white/80">About <%= settings.businessName %></p>
                <h1 class="font-primary font-normal text-[36px] leading-[42px] sm:text-[56px] sm:leading-[62px] lg:text-[72px] lg:leading-[80px]">A studio for calm, considered living.</h1>
              </div>
            </div>
          </div>

          <div class="absolute bottom-10 sm:bottom-14 left-0 w-full z-10 px-4">
            <div class="container-x flex justify-center">
              <p class="font-secondary text-[14px] leading-[20px] text-white/90 text-center max-w-[520px]">
                We're an interior design &amp; civil engineering studio based in <%= settings.heroStudioLocation %>, shaping residential and commercial spaces for people who care how a room feels — not just how it looks.
              </p>
            </div>
          </div>
        </section>

        <!-- WHERE DESIGN MEETS EVERYDAY LIVING -->
        <section id="where-design" class="bg-[#f4f0e8] py-16 sm:py-24 md:py-[100px] lg:py-[125px]">
          <div class="container-x">
            <div class="max-w-[760px] mx-auto text-center space-y-6">
              <h2 class="font-primary font-normal text-[28px] sm:text-[36px] md:text-[42px] lg:text-[48px] leading-[1.15] text-black"><%= settings.aboutTagline %></h2>
              <p class="font-secondary text-[14px] leading-[20px] text-black/70 max-w-[640px] mx-auto">
                <%= settings.aboutContent %>
              </p>
            </div>
          </div>
        </section>

        <!-- MEET THE TEAM -->
        <section id="team" class="bg-[#f4f0e8] pb-16 sm:pb-24 md:pb-[100px] lg:pb-[125px]">
          <div class="container-x space-y-12 sm:space-y-16">
            <h2 class="font-primary font-normal text-center text-[28px] sm:text-[36px] md:text-[42px] lg:text-[48px] leading-[1.15] text-black">Meet the Team</h2>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6 lg:gap-8">
              <% team.forEach(function(m) { %>
                <div class="space-y-4">
                  <div class="w-full max-w-[325px] mx-auto aspect-[4/5] overflow-hidden bg-black/5">
                    <img class="w-full h-full object-cover" src="<%= m.image %>" alt="<%= m.name %>">
                  </div>
                  <div class="text-center space-y-[10px]">
                    <p class="font-primary text-[22px] leading-[26px] text-black"><%= m.name %></p>
                    <p class="font-secondary text-[14px] leading-[20px] text-black/55"><%= m.role %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </section>

        <!-- OUR PHILOSOPHY -->
        <section id="philosophy" class="bg-[#ece7de] py-16 sm:py-24 md:py-[100px] lg:py-[125px] overflow-hidden">
          <div class="container-x">
            <div class="flex flex-col lg:flex-row gap-12 lg:gap-[100px] items-center">

              <div class="space-y-6 w-full lg:max-w-[430px] lg:shrink-0">
                <h2 class="font-primary font-normal text-[36px] sm:text-[48px] lg:text-[56px] leading-[1.05] text-black">Our <br> Philosophy</h2>
                <p class="font-secondary text-[14px] leading-[20px] text-black/70">
                  We believe great interior design goes beyond aesthetics. Every space should feel intentional, functional, and emotionally grounded. Our work is guided by balance, proportion, and a deep respect for how people actually live within the spaces we create.
                </p>
              </div>

              <div class="w-full lg:flex-1 grid grid-cols-2 gap-4 sm:gap-6 items-start">
                <div class="flex flex-col gap-4 sm:gap-6">
                  <div class="w-3/4 ml-auto aspect-[4/3] overflow-hidden">
                    <img class="w-full h-full object-cover" src="https://framerusercontent.com/images/O64BvWg7qKxhwTsoaMwOogOpIws.png?scale-down-to=512&width=1200&height=1200" alt="Interior detail">
                  </div>
                  <div class="w-full aspect-[5/4] overflow-hidden">
                    <img class="w-full h-full object-cover" src="https://framerusercontent.com/images/T6geNXuDqq1KVexrgVr7YFywx4.png?scale-down-to=1024&width=1200&height=802" alt="Interior room">
                  </div>
                </div>

                <div class="pt-14 sm:pt-24">
                  <div class="w-full aspect-[3/4] overflow-hidden">
                    <img class="w-full h-full object-cover" src="https://framerusercontent.com/images/VC4qwfmfo0MFJmeX4tEZEVbnjn8.png?width=1200&height=800" alt="Interior styling">
                  </div>
                </div>
              </div>

            </div>
          </div>
        </section>

      </main>

      <%- include('../partials/cta') %>
      <%- include('../partials/footer') %>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <%- include('../partials/scripts-common') %>

  </body>
</html>
